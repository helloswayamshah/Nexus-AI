	@echo "    make db-shell        open psql shell"
	@echo "    make db-clean        stop + wipe postgres volume (destructive)"
	@echo ""
	@echo "  MIGRATIONS"
	@echo "    make migrate                    apply all pending migrations"
	@echo "    make migrate-sqlite             apply migrations against SQLite"
	@echo "    make migrate-new m=description  create autogenerated migration"
	@echo "    make migrate-down               roll back one migration"
	@echo "    make migrate-base               roll back all migrations"
