# ═══════════════════════════════════════════════════════════════════════════
# Nexus — top-level Makefile  (Windows + macOS/Linux)
#
# Each target does exactly one thing. Compose them yourself:
#   make db          start postgres
#   make migrate     apply migrations
#   make api         start oracle with hot-reload
#
# Or use the shortcuts:
#   make dev         db + migrate + api (postgres in Docker)
#   make dev-sqlite  migrate-sqlite + api-sqlite (zero Docker)
# ═══════════════════════════════════════════════════════════════════════════

ORACLE_DIR       := oracle
COMPOSE_FILE     := docker-compose.yml
K8S_DIR          := k8s
ORACLE_IMAGE     := nexus-oracle:local
MINIKUBE_PROFILE := nexus

# ── OS detection ──────────────────────────────────────────────────────────
# GNU Make sets OS=Windows_NT on all Windows versions.
ifeq ($(OS),Windows_NT)
  SHELL       := powershell.exe
  .SHELLFLAGS := -NoProfile -NonInteractive -Command

  # portable aliases
  WHICH        = where
  RM           = Remove-Item -Force -ErrorAction SilentlyContinue
  MKDIR        = New-Item -ItemType Directory -Force
  SET_ENV      = $$env:
  CD           = Set-Location
  TEST_FILE    = Test-Path
  ECHO         = Write-Host
  # cd into ORACLE_DIR before running a command
  IN_ORACLE    = Set-Location $(ORACLE_DIR);
  # set an env var inline: $(call SETENV,VAR,val) cmd
  SETENV       = $$env:$(1) = "$(2)";
else
  SHELL       := /bin/bash
  .SHELLFLAGS := -euo pipefail -c

  WHICH        = which
  RM           = rm -f
  MKDIR        = mkdir -p
  SET_ENV      = export
  CD           = cd
  TEST_FILE    = test -f
  ECHO         = echo
  IN_ORACLE    = cd $(ORACLE_DIR) &&
  SETENV       = $(1)=$(2)
endif

.DEFAULT_GOAL := help

