# ═══════════════════════════════════════════════════════════════════════════
# Nexus Oracle — environment configuration
# Copy to .env and fill in values marked <REQUIRED>.
# All other values have safe defaults for local dev.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────
# Change this ONE line to switch providers. Run `make migrate` after.
#
# PostgreSQL via docker-compose (default):
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus
#
# PostgreSQL hosted:
#   DATABASE_URL=postgresql+asyncpg://user:pass@your-host.com:5432/nexus
#
# SQLite (no Docker needed — fastest for solo dev):
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── Postgres (docker-compose only) ───────────────────────────────────────
POSTGRES_PASSWORD=nexus
POSTGRES_PORT=5433

# ── Security ─────────────────────────────────────────────────────────────
# AES-256-GCM key — shared with Node.js adapters (same format).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=<REQUIRED>

# JWT signing secret — change before any non-local deployment.
JWT_SECRET=dev-secret-change-in-production

# ── Oracle server ────────────────────────────────────────────────────────
ORACLE_HOST=0.0.0.0
ORACLE_PORT=8000
DEBUG=false

# ── Logging ──────────────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
# LOG_FORMAT: json (structured, for prod) | "" (human-readable, for dev)
LOG_LEVEL=info
LOG_FORMAT=

# ── LLM (Ollama) ─────────────────────────────────────────────────────────
LLM_DEFAULT_BASE_URL=http://localhost:11434
LLM_DEFAULT_MODEL=llama3.1

# ── STT (Whisper) ────────────────────────────────────────────────────────
STT_DEFAULT_PROVIDER=whispercpp
WHISPER_MODELS_DIR=/opt/whisper-models
